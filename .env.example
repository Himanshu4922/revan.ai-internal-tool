# App
APP_ENV=production
GIN_MODE=release
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
APP_ENCRYPTION_KEY= # openssl rand -hex 32
# Set COOKIE_SECURE=false for plain HTTP local access; true behind HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3095,http://127.0.0.1:3095

# Seed admin (created on first boot if missing)
ADMIN_EMAIL=admin@ravan.ai
ADMIN_PASSWORD=change-me-strong-password

# Optional seed viewer
VIEWER_EMAIL=
VIEWER_PASSWORD=

# Postgres (compose)
POSTGRES_USER=keymon
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=agni_keymon
POSTGRES_PORT=5433
DATABASE_URL=postgres://keymon:change-me-db-password@postgres:5432/agni_keymon?sslmode=disable

# Host ports (loopback) — avoid WhatsAppX 8080/3000
BACKEND_PORT=8095
FRONTEND_PORT=3095

# Credit checker
CHECK_INTERVAL_MINUTES=20
ALERT_LOW_THRESHOLD=5
ALERT_COOLDOWN_HOURS=6

# Local Periskope / WhatsAppX alerts (self-hosted only — do NOT use api.periskope.app)
# From Docker, host WhatsAppX is reached via host.docker.internal (see compose extra_hosts).
# Match local-periskope BACKEND_PORT (often 8080 or 8081).
WHATSAPPX_BASE_URL=http://host.docker.internal:8080
# Write-scope API key from the WhatsAppX workspace
WHATSAPPX_API_KEY=
# Destination: international phone digits, or a group/linked chat jid (...@g.us / ...@lid)
WHATSAPPX_TO=

# Agni calling alerts
CALLING_API_BASE=https://api.ravan.ai
CALLING_INTERNAL_KEY=
ALERT_CALL_AGENT_ID=
ALERT_CALL_FROM=
ALERT_CALL_TO=
ALERT_CALL_ORG_ID=

# Frontend → API (browser hits same origin via Next rewrite, or set public URL)
API_INTERNAL_URL=http://backend:8080
NEXT_PUBLIC_APP_NAME=Agni Key Monitor
